# Clé gratuite à créer sur https://www.football-data.org/client/register
# Elle est lue UNIQUEMENT côté serveur (proxy /api/football) : ne la préfixez jamais par VITE_,
# sinon elle serait visible dans le navigateur.
# Laisser vide = mode démonstration (données fictives).
FOOTBALL_DATA_API_KEY=

# Clé API Anthropic pour l'analyse IA des matchs (Claude Opus 5.5) : https://console.anthropic.com
# Également côté serveur uniquement. Chaque analyse est facturée sur votre compte Anthropic.
ANTHROPIC_API_KEY=
